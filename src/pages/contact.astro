---
import BaseLayout from '../layouts/BaseLayout.astro'
import PageTitle from '../components/PageTitle.astro'
import ContactBox from '../components/ContactBox.astro'
import { siteData as hospital, siteId } from '../lib/site-data.js'
import { COMPANY_SITE } from '../lib/site-id.js'

// home.contactTitle이 있으면 페이지 제목·설명에 반영 (없으면 기존 그대로)
const contactTitle = hospital.home?.contactTitle

// AI SEO Lab 회사 홈페이지는 내부 도구라 이 페이지가 nav에 없습니다 — 검색엔진에는 노출하지 않습니다.
const isCompanySite = siteId === COMPANY_SITE
---

<BaseLayout
  title={contactTitle ?? '상담문의'}
  description={contactTitle ? `${hospital.name} ${contactTitle} 안내` : `${hospital.name} 상담 및 오시는 길 안내`}
  noindex={isCompanySite}
>
  <PageTitle title={contactTitle ?? '상담문의'} />
  <ContactBox />
</BaseLayout>
